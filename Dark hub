-- Asks the API for servers with this boss and tries to join them.
-- The API reports servers of different places (placeId); each report is
-- joined in ITS OWN place, so it also works when we are in another sea.
function Hop.join(bossId, cooldown)
    if Hop.busy[bossId] then return end
    if tick() - (Hop.last[bossId] or 0) < (cooldown or 8) then return end
    Hop.busy[bossId], Hop.last[bossId] = true, tick()
    task.spawn(function()
        local ok, err = pcall(function()
            if not Hop.request then error("your executor has no HTTP request function") end
            local res = Hop.request({
                Url = Hop.API .. "/api/logs/" .. bossId:lower(),
                Method = "GET",
                Headers = {["Content-Type"] = "application/json"},
            })
            if not res or not (res.StatusCode == 200 or res.Success == true) then
                error("the API did not answer (" .. tostring(res and res.StatusCode) .. ")")
            end
            local decoded = Hop.Http:JSONDecode(res.Body)
            local entries = decoded[bossId:lower()]
            if not entries or #entries == 0 then error("no recent report of this boss") end

            -- newest first; servers in our own place come before the others
            local same, other, seen = {}, {}, {}
            for i = #entries, 1, -1 do
                local e = entries[i]
                if e.jobId and e.jobId ~= "" then
                    local good, job = pcall(Hop.decode, e.jobId)
                    local cur, max = tostring(e.players or ""):match("(%d+)%s*/%s*(%d+)")
                    local full = cur and max and tonumber(cur) >= tonumber(max)
                    if good and job and job ~= "" and job ~= game.JobId and not seen[job] and not full then
                        seen[job] = true
                        local pid = tonumber(e.placeId) or game.PlaceId
                        table.insert(pid == game.PlaceId and same or other, {job = job, place = pid})
                    end
                end
            end
            local list = {}
            for _, x in ipairs(same) do table.insert(list, x) end
            for _, x in ipairs(other) do table.insert(list, x) end
            if #list == 0 then error("no valid server found") end
            if #list > 25 then for i = #list, 26, -1 do list[i] = nil end end

            -- the script has to run again in the new server: Auto Execute (Settings) does that
            Hop.save(true)
            if not State.AutoExec then
                hopNote("Turn on Auto Execute in Settings so the script runs again after the hop")
            end

            local currentJob = game.JobId
            local browser = RS:FindFirstChild("__ServerBrowser")
            for _, sv in ipairs(list) do
                if game.JobId ~= currentJob then break end
                local failed = false
                local conn = Hop.TS.TeleportInitFailed:Connect(function() failed = true end)
                pcall(function()
                    if browser and sv.place == game.PlaceId then
                        browser:InvokeServer("teleport", sv.job)
                    else
                        Hop.TS:TeleportToPlaceInstance(sv.place, sv.job, Player)
                    end
                end)
                for _ = 1, 12 do
                    task.wait(0.5)
                    if failed or game.JobId ~= currentJob then break end
                end
                conn:Disconnect()
                if game.JobId ~= currentJob then break end
                task.wait(0.5)
            end
            if game.JobId == currentJob then
                Hop.save(false)
                error("could not join any server (full or closed)")
            end
        end)
        if not ok then hopNote("Hop: " .. tostring(err)) end
        Hop.busy[bossId] = false
    end)
end

-- Runs the "Boss + Hop" options. Returns true while busy.
-- No sea check: if the boss is here we fight him, otherwise we join a server
-- from the API (even one of another sea: the API gives the place of each one).
function Hop.step()
    for _, b in ipairs(Hop.BOSSES) do
        if State.HopOn[b.id] then
            local fighting
            if b.id == "CursedCaptain" and (CURRENT_SEA == 2 or CURRENT_SEA == nil) then
                fighting = killCaptain()
            else
                fighting = farmMobs({Mobs = b.names})
            end
            if fighting then
                setStatus(b.label .. " + Hop | fighting")
                return true
            end
            if tick() - Hop.startAt > 10 then
                setStatus(b.label .. " + Hop | not spawned here, searching a server with him")
                Hop.join(b.id, 8)
            else
                setStatus(b.label .. " + Hop | checking this server")
            end
            return true
        end
    end
    return Hop.eventStep()
end

