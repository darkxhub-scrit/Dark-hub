            local dir = target.HumanoidRootPart.Position - root.Position
            if dir.Magnitude > 0 then
                pcall(function() remote:FireServer(dir.Unit, 1) end)
            end
            registerHits(list)
        elseif not remote then
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(1280, 672))
            VirtualUser:Button1Up(Vector2.new(1280, 672))
            registerHits(list)
        end
    elseif State.FastAttack and RegisterAttack and RegisterHit and #list > 0 then
        registerHits(list)
    else
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
        task.wait(0.03)
        VirtualUser:Button1Up(Vector2.new(1280, 672))
    end
end

