end)
local function flyTo(cf)
    if not State.Farming then return end
    local root = getRoot()
    if not root then return end
    local dist = (root.Position - cf.Position).Magnitude
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(root, TweenInfo.new(dist / FLY_SPEED, Enum.EasingStyle.Linear), {CFrame = cf})
    currentTween:Play()
    return currentTween, dist / FLY_SPEED
end

-- Flies and waits until we arrive. Never waits forever: gives up when the
-- character dies / is replaced, when farming is turned off, or after the
-- expected flight time (a tween of a dead character never finishes, which
-- used to freeze the whole farm loop after dying).
local function flyAndWait(cf)
    local root0 = getRoot()
    local t, dur = flyTo(cf)
    if not t then return false end
    local done = false
    local conn = t.Completed:Connect(function() done = true end)
    local t0 = tick()
    while not done and tick() - t0 < dur + 2 do
        task.wait(0.1)
        local r, h = getRoot()
        if not State.Farming or not r or r ~= root0 or not h or h.Health <= 0 then break end
    end
    conn:Disconnect()
    return done and t.PlaybackState == Enum.PlaybackState.Completed
end

