-- Learn Trade: records the remote calls (RemoteFunction / RemoteEvent) made for
-- 90 s while you do a trade by hand, and saves them to DarkHub_remotes.txt.
-- The hook never calls methods on the objects (that would call the hook again).
local Learn = {on = false, hooked = false, lines = {}, t0 = 0}
local function learnHook()
    if Learn.hooked or not (hookmetamethod and getnamecallmethod) then return end
    Learn.hooked = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
            local method = getnamecallmethod()
            if Learn.on and typeof(self) == "Instance" and (self.ClassName == "RemoteFunction" or self.ClassName == "RemoteEvent") and (method == "InvokeServer" or method == "FireServer") then
                local parts = {}
                for i, v in ipairs({...}) do
                    parts[i] = typeof(v) == "Instance" and ("<" .. v.Name .. ">") or tostring(v)
                end
                table.insert(Learn.lines, string.format("%.1fs | %s | %s | %s", tick() - Learn.t0, self.Name, method, table.concat(parts, " , ")))
            end
            return old(self, ...)
        end))
    end)
end

local function learnStart()
    learnHook()
    if not Learn.hooked then
        Fluent:Notify({Title = "Dark Hub", Content = "Your executor cannot record remote calls (hookmetamethod missing).", Duration = 8})
        return
    end
    Learn.lines, Learn.t0, Learn.on = {}, tick(), true
    Fluent:Notify({Title = "Dark Hub", Content = "Recording for 90 s. Make the trade by hand now.", Duration = 8})
    task.delay(90, function()
        Learn.on = false
        local ok = pcall(writefile, "DarkHub_remotes.txt", table.concat(Learn.lines, "\n"))
        Fluent:Notify({Title = "Dark Hub", Content = ok and (#Learn.lines .. " calls saved to DarkHub_remotes.txt") or "Could not save DarkHub_remotes.txt", Duration = 8})
    end)
end

