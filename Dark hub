-- Opens the fruit shop: the shop window if the game has it, otherwise the fruit dealer NPC
local function openFruitShop()
    pcall(function() RS.Remotes.CommF_:InvokeServer("GetFruits") end)
    local main = Player.PlayerGui:FindFirstChild("Main")
    if main then
        for _, c in ipairs(main:GetChildren()) do
            local n = c.Name:lower()
            if c:IsA("GuiObject") and n:find("fruit") and n:find("shop") then
                c.Visible = true
                return true
            end
        end
    end
    -- no window found: go to the nearest fruit dealer and press "Interact"
    local npcs = workspace:FindFirstChild("NPCs")
    local root = getRoot()
    if not (npcs and root) then return false end
    local best, bestD = nil, math.huge
    for _, n in ipairs(npcs:GetChildren()) do
        if n.Name:find("Fruit Dealer", 1, true) or n.Name:find("Fruit Shop", 1, true) then
            local okp, p = pcall(function() return n:GetPivot().Position end)
            if okp then
                local d = (p - root.Position).Magnitude
                if d < bestD then best, bestD = n, d end
            end
        end
    end
    if not best then return false end
    root.CFrame = best:GetPivot() * CFrame.new(0, 2, 6)
    task.wait(0.6)
    local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
    end
    return true
end

