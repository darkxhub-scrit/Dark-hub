local function detectSea()
    local fromPlace = PLACE_SEA[game.PlaceId]
    if fromPlace then return fromPlace end
    for _, root in ipairs({Player:FindFirstChild("PlayerGui"), game:GetService("CoreGui")}) do
        pcall(function()
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local n = d.Text:match("%-Sea(%d)")
                    if n then fromPlace = tonumber(n) return end
                end
            end
        end)
        if fromPlace then return fromPlace end
    end
    local wo = workspace:FindFirstChild("_WorldOrigin")
    local spawns = wo and wo:FindFirstChild("EnemySpawns")
    if spawns then
        local hints = {
            {3, {"Reborn Skeleton", "Cookie Crafter", "Pirate Millionaire", "Dragon Crew"}},
            {2, {"Snow Lurker", "Arctic Warrior", "Mercenary", "Raider"}},
            {1, {"Bandit", "Monkey", "Gorilla", "Pirate"}},
        }
        for _, h in ipairs(hints) do
            for _, c in ipairs(spawns:GetChildren()) do
                for _, name in ipairs(h[2]) do
                    if c.Name:find(name, 1, true) then return h[1] end
                end
            end
        end
    end
end
