-- FPS Boost: no shadows / particles / effects, plain materials, flat water
local fpsFx = setmetatable({}, {__mode = "k"})
local fpsParts = setmetatable({}, {__mode = "k"})
local fpsOn, fpsConn, fpsLighting, fpsWater = false, nil, nil, nil

local function fpsKill(o)
    if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke") or o:IsA("Fire")
        or o:IsA("Sparkles") or o:IsA("BloomEffect") or o:IsA("BlurEffect") or o:IsA("SunRaysEffect")
        or o:IsA("DepthOfFieldEffect") then
        if fpsFx[o] == nil then fpsFx[o] = o.Enabled end
        o.Enabled = false
    elseif o:IsA("BasePart") and not o:IsA("Terrain") then
        if fpsParts[o] == nil then fpsParts[o] = {o.Material, o.Reflectance, o.CastShadow} end
        o.Material = Enum.Material.SmoothPlastic
        o.Reflectance = 0
        o.CastShadow = false
    end
end

local function setFpsBoost(on)
    if on == fpsOn then return end
    fpsOn = on
    if on then
        fpsLighting = {Lighting.GlobalShadows}
        pcall(function() fpsLighting.quality = settings().Rendering.QualityLevel end)
        Lighting.GlobalShadows = false
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function() sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility) end)
        pcall(function()
            local t = workspace.Terrain
            fpsWater = {t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance}
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
        end)
        for _, o in ipairs(Lighting:GetDescendants()) do pcall(fpsKill, o) end
        fpsConn = workspace.DescendantAdded:Connect(function(o)
            if fpsOn then pcall(fpsKill, o) end
        end)
        task.spawn(function()
            local n = 0
            for _, o in ipairs(workspace:GetDescendants()) do
                if not fpsOn then return end
                pcall(fpsKill, o)
                n += 1
                if n % 400 == 0 then task.wait() end -- do not freeze the game
            end
        end)
    else
        if fpsConn then fpsConn:Disconnect() fpsConn = nil end
        if fpsLighting then
            Lighting.GlobalShadows = fpsLighting[1]
            if fpsLighting.quality then pcall(function() settings().Rendering.QualityLevel = fpsLighting.quality end) end
        end
        if fpsWater then
            pcall(function()
                local t = workspace.Terrain
                t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = fpsWater[1], fpsWater[2], fpsWater[3]
            end)
        end
        for o, was in pairs(fpsFx) do pcall(function() o.Enabled = was end) end
        for o, v in pairs(fpsParts) do
            pcall(function() o.Material, o.Reflectance, o.CastShadow = v[1], v[2], v[3] end)
        end
        fpsFx = setmetatable({}, {__mode = "k"})
        fpsParts = setmetatable({}, {__mode = "k"})
    end
end
