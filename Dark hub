-- Auto Cyborg (Sea 2, Hot and Cold island)
-- 1) Fist of Darkness (chests + server hop)  2) insert it in the Secret Laboratory
-- 3) Order (Law) raids until the Core Brain drops  4) use the Core Brain on the lab
-- button (opens the secret door) and buy the Cyborg race.
-- NOTE: the lab button is searched by name next to the NPC Arlthmetic; the Microchip
-- purchase is tried with a few guesses and, if they fail, learned from your own purchase.
---------------------------------------------------------------------
State.Cyborg = false

local Cyb = {
    FILE = "DarkHub_cyborg.json",
    FIST = "Fist of Darkness", BRAIN = "Core Brain",
    CHIP_COST = 1000, RACE_COST = 2500,
    ORDER = {"Order"},
    LAB_WORDS = {"raid", "summon", "button", "order", "law", "lab", "chip", "start"},
    BUY_TRIES = {{"RaidsNpc", "Select", "Order"}, {"RaidsNpc", "Select", "Law"}, {"Arlthmetic", "Buy"}},
    IGNORED = {getInventory = true, Buso = true, SetTeam = true},
    fist = false, door = false, spot = nil, recipe = nil,
    last = {}, recent = {},
}

pcall(function()
    if isfile and isfile(Cyb.FILE) then
        local d = Hop.Http:JSONDecode(readfile(Cyb.FILE))
        Cyb.fist, Cyb.door = d.fist == true, d.door == true
        if type(d.recipe) == "table" then Cyb.recipe = d.recipe end
        if type(d.spot) == "table" then Cyb.spot = Vector3.new(d.spot[1], d.spot[2], d.spot[3]) end
    end
end)

function Cyb.save()
    pcall(function()
        writefile(Cyb.FILE, Hop.Http:JSONEncode({
            fist = Cyb.fist, door = Cyb.door, recipe = Cyb.recipe,
            spot = Cyb.spot and {Cyb.spot.X, Cyb.spot.Y, Cyb.spot.Z} or nil,
        }))
    end)
end

function Cyb.reset()
    Cyb.last, Cyb.wait = {}, 0
    Cyb.fired, Cyb.variant, Cyb.insertTry, Cyb.brainTry, Cyb.raceTry, Cyb.buyTry = 0, 0, 0, 0, 0, 0
    Cyb.noChestAt, Cyb.noNpcAt, Cyb.pressAt = nil, nil, 0
end
Cyb.reset()

-- Items: the Fist / Core Brain / Microchip are tools of the backpack (or of the inventory list)
local function hasItem(name)
    for _, c in ipairs({Player.Backpack, Player.Character}) do
        if c and c:FindFirstChild(name) then return true end
    end
    return inventoryCount(name) > 0
end

local function hasChip()
    for _, c in ipairs({Player.Backpack, Player.Character}) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("microchip", 1, true) then return true end
            end
        end
    end
    return false
end

local function fragments()
    local d = Player:FindFirstChild("Data")
    local f = d and d:FindFirstChild("Fragments")
    return f and f.Value
end

-- Flies towards a position, true when we are there
function Cyb.goTo(pos, near)
    local root = getRoot()
    if not root then return false end
    if (root.Position - pos).Magnitude <= near then return true end
    setHover(true)
    flyTo(CFrame.new(pos))
    return false
end

-- Joins a random public server that has room (used to look for more chests)
function Hop.anyServer()
    local ok, res = pcall(function()
        return Hop.Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    local pool = {}
    if ok and type(res) == "table" and res.data then
        for _, sv in ipairs(res.data) do
            if sv.id ~= game.JobId and sv.playing < sv.maxPlayers then table.insert(pool, sv.id) end
        end
    end
    if #pool == 0 then return false end
    local job = game.JobId
    Hop.save(true)
    pcall(function() Hop.TS:TeleportToPlaceInstance(game.PlaceId, pool[math.random(#pool)], Player) end)
    for _ = 1, 16 do
        task.wait(0.5)
        if game.JobId ~= job then return true end
    end
    Hop.save(false)
    return false
end

-- Arlthmetic (sells the Order raid Microchip) lives next to the Secret Laboratory
local function labNPC()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    for _, n in ipairs(npcs:GetChildren()) do
        local name = n.Name:lower()
        if name:find("ar[li]thmetic") or name:find("junior j", 1, true) then return n end
    end
end

-- Center of the lab: the saved raid spot, else Arlthmetic, else the hot side of the island
-- (second value: true when the position is exact)
function Cyb.center()
    if Cyb.spot then return Cyb.spot, true end
    local npc = labNPC()
    if npc then
        local ok, p = pcall(function() return npc:GetPivot().Position end)
        if ok then return p, true end
    end
    local sp = findSpawn({"Lava Pirate", "Magma Ninja"})
    return sp and sp.Position or Vector3.new(-5400, 60, -5200), false
end

-- Buttons (ClickDetector / ProximityPrompt) around the lab, the ones with a raid-like name first
function Cyb.buttons(center)
    if Cyb.btnCache and Cyb.btnFor and (Cyb.btnFor - center).Magnitude < 10 then return Cyb.btnCache end
    local named, plain, count = {}, {}, 0
    local npcs = workspace:FindFirstChild("NPCs")
    for _, d in ipairs(workspace:GetDescendants()) do
        count += 1
        if count % 3000 == 0 then task.wait() end -- do not freeze the game
        if (d:IsA("ClickDetector") or d:IsA("ProximityPrompt")) and not (npcs and d:IsDescendantOf(npcs)) then
            local part = d.Parent
            if not (part and part:IsA("BasePart")) then part = d:FindFirstAncestorWhichIsA("BasePart") end
            if part then
                local dist = (part.Position - center).Magnitude
                if dist <= 300 then
                    local hits, node = 0, d
                    for _ = 1, 4 do
                        node = node.Parent
                        if not node or node == workspace then break end
                        local nm = node.Name:lower()
                        for _, w in ipairs(Cyb.LAB_WORDS) do
                            if nm:find(w, 1, true) then hits += 1 break end
                        end
                    end
                    table.insert(hits > 0 and named or plain, {obj = d, pos = part.Position, hits = hits, dist = dist})
                end
            end
        end
    end
    local list = #named > 0 and named or plain
    table.sort(list, function(a, b)
        if a.hits ~= b.hits then return a.hits > b.hits end
        return a.dist < b.dist
    end)
    Cyb.btnCache, Cyb.btnFor = list, center
    return list
end

-- Stands where the host stands (saved raid spot, else on a button), puts everything down
-- and presses the lab button(s). Returns "fired" after a press, otherwise "moving" / "wait".
function Cyb.press(center)
    local list = Cyb.buttons(center)
    if #list == 0 and not Cyb.spot then
        hopNote("No lab button found. Stand inside the dark blue chamber of the Secret Laboratory and press Save Raid Spot (Stack Farm).")
        return "wait"
    end
    local target = Cyb.spot
    if not target then
        local b = list[(Cyb.variant % #list) + 1]
        target = b.pos + Vector3.new(0, 3, 0)
    end
    if not Cyb.goTo(target, 5) then return "moving" end
    local root, hum = getRoot()
    local char = Player.Character
    if hum and char and char:FindFirstChildOfClass("Tool") then
        hum:UnequipTools() -- the game does not accept the button while you hold something
        return "wait"
    end
    if tick() - Cyb.last.press < 3 then return "wait" end
    Cyb.last.press = tick()
    Cyb.fired += 1
    if Cyb.fired % 3 == 0 then Cyb.variant += 1 end -- not working: try the next button
    local n, first = 0, nil
    for _, b in ipairs(list) do
        if n >= 4 then break end
        if b.obj.Parent and (b.pos - root.Position).Magnitude <= 60 then
            n += 1
            first = first or b.obj:GetFullName()
            pcall(function()
                if b.obj:IsA("ClickDetector") then fireclickdetector(b.obj) else fireproximityprompt(b.obj) end
            end)
        end
    end
    hopNote("Lab: pressed " .. n .. " button(s)" .. (first and (" (" .. first:sub(-55) .. ")") or ""))
    return "fired"
end

-- Learns the remote call that buys the Microchip: the CommF_ calls are remembered and,
-- when a Microchip shows up in the backpack, the call made just before it is saved
function Cyb.hook()
    if Cyb.hooked or not (hookmetamethod and getnamecallmethod) then return end
    local commF = RS.Remotes.CommF_
    local old
    Cyb.hooked = pcall(function()
        old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
            local method = getnamecallmethod()
            if self == commF and method == "InvokeServer" then
                table.insert(Cyb.recent, {t = tick(), args = {...}})
                if #Cyb.recent > 8 then table.remove(Cyb.recent, 1) end
            end
            return old(self, ...)
        end))
    end)
end

local function simpleArgs(args)
    for _, a in ipairs(args) do
        local t = type(a)
        if t ~= "string" and t ~= "number" and t ~= "boolean" then return false end
    end
    return #args > 0
end

local function watchBackpack()
    local bp = Player:WaitForChild("Backpack", 10)
    if not bp then return end
    bp.ChildAdded:Connect(function(t)
        if Cyb.recipe or not Cyb.hooked or not t:IsA("Tool") or not t.Name:lower():find("microchip", 1, true) then return end
        for i = #Cyb.recent, 1, -1 do
            local r = Cyb.recent[i]
            if tick() - r.t < 8 and not Cyb.IGNORED[r.args[1]] and simpleArgs(r.args) then
                Cyb.recipe = r.args
                Cyb.save()
                Fluent:Notify({Title = "Dark Hub", Content = "Learned how to buy the Microchip (" .. tostring(r.args[1]) .. "). It will be repeated by itself.", Duration = 8})
                return
            end
        end
    end)
end
task.spawn(watchBackpack)
Player.CharacterAdded:Connect(function() task.spawn(watchBackpack) end)

-- Buys the Order raid Microchip from Arlthmetic (1000 Fragments)
function Cyb.buyChip()
    local npc = labNPC()
    local ok, p = false, nil
    if npc then ok, p = pcall(function() return npc:GetPivot().Position end) end
    if not ok then p = (Cyb.center()) end
    if not Cyb.goTo(p + Vector3.new(0, 4, 0), 15) or not npc then return end
    if tick() - (Cyb.last.buy or 0) < 4 then return end
    Cyb.last.buy = tick()
    local calls = Cyb.recipe and {Cyb.recipe} or Cyb.BUY_TRIES
    if not Cyb.recipe then Cyb.hook() end
    if not Cyb.recipe and Cyb.buyTry >= #calls * 2 then
        hopNote("Buy the Microchip from Arlthmetic by hand once (" .. Cyb.CHIP_COST .. " Fragments): the script learns the purchase and repeats it by itself.")
        return
    end
    Cyb.buyTry += 1
    local args = calls[(Cyb.buyTry - 1) % #calls + 1]
    pcall(function() RS.Remotes.CommF_:InvokeServer(table.unpack(args)) end)
end

-- Makes sure we are at the lab; returns its center, or nil while flying there
local function labReady(tag, step)
    local center, exact = Cyb.center()
    if exact then return center end
    setStatus(tag .. step .. " flying to the lab of Hot and Cold")
    if Cyb.goTo(center, 80) then
        Cyb.noNpcAt = Cyb.noNpcAt or tick()
        if tick() - Cyb.noNpcAt > 10 then
            hopNote("Arlthmetic not found. Stand inside the dark blue chamber of the Secret Laboratory and press Save Raid Spot (Stack Farm).")
        end
    end
end

local function startRaid(tag)
    local center = labReady(tag, "3/4")
    if not center then return end
    setStatus(tag .. "3/4 starting the Order (Law) raid")
    if tick() < Cyb.wait then return end
    if Cyb.press(center) == "fired" then
        Cyb.pressAt = tick()
        Cyb.wait = tick() + 8
    end
end

local function insertFist(tag)
    local center = labReady(tag, "2/4")
    if not center then return end
    setStatus(tag .. "2/4 inserting the Fist of Darkness in the Secret Laboratory")
    if tick() < Cyb.wait then return end
    if Cyb.insertTry > 0 and not hasItem(Cyb.FIST) then -- it was taken by the machine
        Cyb.fist = true
        Cyb.save()
        pcall(function() Fluent.Options.CyborgFist:SetValue(true) end)
        Fluent:Notify({Title = "Dark Hub", Content = "Fist of Darkness inserted. Now the Order raids run until the Core Brain drops.", Duration = 8})
        return
    end
    if Cyb.press(center) == "fired" then
        Cyb.insertTry += 1
        Cyb.wait = tick() + 6
        if Cyb.insertTry == 8 then
            hopNote("The Fist is not being accepted. Stand inside the dark blue chamber and press Save Raid Spot (Stack Farm).")
        end
    end
end

local function raidLoop(tag)
    if hasChip() then
        startRaid(tag)
        return
    end
    local f = fragments()
    if f and f < Cyb.CHIP_COST then
        setStatus(tag .. "3/4 need " .. Cyb.CHIP_COST .. " Fragments for the next Microchip (you have " .. f .. ")")
        return
    end
    setStatus(tag .. "3/4 buying the Microchip from Arlthmetic")
    Cyb.buyChip()
end

local function useBrain(tag)
    local center = labReady(tag, "4/4")
    if not center then return end
    setStatus(tag .. "4/4 using the Core Brain on the lab button (opens the secret door)")
    if tick() < Cyb.wait then return end
    if Cyb.brainTry >= 1 and (not hasItem(Cyb.BRAIN) or Cyb.brainTry >= 3) then
        Cyb.door = true
        Cyb.save()
        return
    end
    if Cyb.press(center) == "fired" then
        Cyb.brainTry += 1
        Cyb.wait = tick() + 6
    end
end

local function buyRace(tag)
    local f = fragments()
    if f and f < Cyb.RACE_COST then
        setStatus(tag .. "4/4 need " .. Cyb.RACE_COST .. " Fragments to buy Cyborg (you have " .. f .. ")")
        return
    end
    setStatus(tag .. "4/4 buying the Cyborg race (" .. Cyb.RACE_COST .. " Fragments)")
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, n in ipairs(npcs:GetChildren()) do
            if n.Name:lower():find("cyborg", 1, true) then
                local ok, p = pcall(function() return n:GetPivot().Position end)
                if ok and not Cyb.goTo(p + Vector3.new(0, 4, 0), 20) then return end
                break
            end
        end
    end
    if tick() - (Cyb.last.race or 0) < 4 then return end
    Cyb.last.race = tick()
    Cyb.raceTry += 1
    local ok, res = pcall(function() return RS.Remotes.CommF_:InvokeServer("CyborgTrainer", "Buy") end)
    if ok and type(res) == "string" then hopNote("Cyborg: " .. res) end
    if Cyb.raceTry >= 6 and hasItem(Cyb.BRAIN) then -- the door did not open: use the Core Brain again
        Cyb.door, Cyb.brainTry, Cyb.raceTry = false, 0, 0
        Cyb.save()
    end
end

local function huntFist(tag)
    if collectChests() then
        Cyb.noChestAt = nil
        setStatus(tag .. "1/4 collecting chests (looking for the Fist of Darkness)")
        return
    end
    Cyb.noChestAt = Cyb.noChestAt or tick()
    if tick() - Cyb.noChestAt < 6 or tick() - Hop.startAt < 12 then
        setStatus(tag .. "1/4 no chests here, checking again")
        return
    end
    setStatus(tag .. "1/4 no more chests in this server, joining another one")
    if tick() - (Cyb.last.hop or 0) > 20 then
        Cyb.last.hop = tick()
        task.spawn(function()
            if not Hop.anyServer() then hopNote("No other server found.") end
        end)
    end
end

local function raidTimerOn()
    local main = Player.PlayerGui:FindFirstChild("Main")
    local t = main and main:FindFirstChild("Timer")
    return t ~= nil and t.Visible and tick() - Cyb.pressAt < 480
end

local function cyborgRace()
    local tag = "Auto Cyborg | "
    if CURRENT_SEA and CURRENT_SEA ~= 2 then
        setStatus(tag .. "only works in Sea 2 (detected: Sea " .. tostring(CURRENT_SEA) .. ")")
        return true
    end
    local data = Player:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race") and data.Race.Value
    if race == "Cyborg" then
        Fluent:Notify({Title = "Dark Hub", Content = "You are Cyborg now!", Duration = 8})
        pcall(function() Fluent.Options.AutoCyborg:SetValue(false) end)
        return false
    end

    local brain = hasItem(Cyb.BRAIN)
    if not invReady then
        setStatus(tag .. "reading your inventory...")
        invAt = 0
        return true
    end

    -- an Order raid is running: fight Order
    if findEnemy(Cyb.ORDER) then
        setStatus(tag .. "3/4 fighting Order (Law raid)")
        farmMobs({Mobs = Cyb.ORDER})
        return true
    end
    if raidTimerOn() then
        setStatus(tag .. "3/4 raid running, waiting for Order")
        return true
    end

    if Cyb.door then
        buyRace(tag)
    elseif brain then
        useBrain(tag)
    elseif hasChip() and not Cyb.fist then
        startRaid(tag) -- a Microchip in the backpack blocks the Fist: use it first
    elseif Cyb.fist then
        raidLoop(tag)
    elseif hasItem(Cyb.FIST) then
        insertFist(tag)
    else
        huntFist(tag)
    end
    return true
end

