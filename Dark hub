-- No mob alive: stay where we were fighting and wait for the respawn
-- (mobs come back in a few seconds). Only after a long time without any
-- mob do we go looking at the spawn points of the farm area.
-- Returns "wait" | "hunt", spawn, distance | "none"
local function idleOrHunt(names, area)
    local key = table.concat(names, "|")
    if State.FightPos and State.FightKey == key and tick() - State.FightAt < 60 then
        setHover(true)
        flyTo(CFrame.new(State.FightPos + Vector3.new(0, ATTACK_HEIGHT, 0)))
        return "wait"
    end
    local sp = findHuntSpawn(names, area)
    if sp then
        local root = getRoot()
        local dist = root and (sp.Position - root.Position).Magnitude or 0
        setHover(true)
        flyTo(sp.CFrame * CFrame.new(0, HOVER_HEIGHT + 8, 0))
        return "hunt", sp, dist
    end
    setHover(false)
    return "none"
end

