local TIKI_POS = Vector3.new(-16269.7, 25.2, 1373.4) -- approximate; the real NPC is searched first
local lastSubTravel, subFails = 0, 0

local function findSubmarineNPC()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    local direct = npcs:FindFirstChild("Submarine Worker")
    if direct then return direct end
