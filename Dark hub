local function bringMobs(target, names)
    if not State.BringMob then return end
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    local count = 1
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        if count >= State.BringCount then break end
        if mob ~= target then
            local match = mob.Name == target.Name
            if not match and names then
                for _, n in ipairs(names) do
                    if mob.Name:find(n, 1, true) then match = true break end
                end
            end
            if match then
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and (hrp.Position - thrp.Position).Magnitude <= 500 then
                    hrp.CFrame = thrp.CFrame
                    hrp.CanCollide = false
                    hum.WalkSpeed = 0
                    count += 1
                end
            end
        end
    end
end

