local function getLevel()
    local d = Player:FindFirstChild("Data")
    return d and d:FindFirstChild("Level") and d.Level.Value or 1
end

local function spawnExists(mob)
    local wo = workspace:FindFirstChild("_WorldOrigin")
    local folder = wo and wo:FindFirstChild("EnemySpawns")
    if not folder then return true end
    for _, s in ipairs(folder:GetChildren()) do
        if s.Name:find(mob, 1, true) then return true end
    end
    return false
end

local SUBMERGED_MOBS = {["Reef Bandit"] = true, ["Coral Pirate"] = true, ["Sea Chanter"] = true,
    ["Ocean Prophet"] = true, ["High Disciple"] = true, ["Grand Devotee"] = true}

local function questValid(mob)
    if CURRENT_SEA == 3 and SUBMERGED_MOBS[mob] then return true end
    return spawnExists(mob)
end

local levelCache = {lvl = nil, data = nil, t = 0, key = nil}

local mobSet
local function getMobSet()
    if mobSet then return mobSet end
    mobSet = {}
    local ok, quests = pcall(function() return require(RS:WaitForChild("Quests", 5)) end)
    if ok and type(quests) == "table" then
        for _, levels in pairs(quests) do
            if type(levels) == "table" then
                for _, q in pairs(levels) do
                    if type(q) == "table" and type(q.Task) == "table" then
                        for n in pairs(q.Task) do mobSet[n] = true end
                    end
                end
            end
        end
    end
    return mobSet
end

local function activeQuestMob()
    local gui = Player.PlayerGui:FindFirstChild("Main")
    local q = gui and gui:FindFirstChild("Quest")
    if not q or not q.Visible then return end
    local ok, text = pcall(function() return q.Container.QuestTitle.Title.Text end)
    if not ok or type(text) ~= "string" then return end
    local cur, max = text:match("(%d+)%s*/%s*(%d+)")
    if cur and max and tonumber(cur) >= tonumber(max) then return end
    local best
    for name in pairs(getMobSet()) do
        if text:find(name, 1, true) and (not best or #name > #best) then best = name end
    end
    return best
end

