                    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id, Player) end)
                    return
                end
            end
        end
        Fluent:Notify({Title = "Dark Hub", Content = "No other server found.", Duration = 6})
    end,
})

